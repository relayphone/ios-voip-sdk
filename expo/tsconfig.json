{
  "extends": "expo-module-scripts/tsconfig.base",
  "compilerOptions": {
    "outDir": "./build",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "rootDir": "./src"
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "**/__mocks__/*",
    "**/__tests__/*",
    "**/__rsc_tests__/*"
  ]
}
