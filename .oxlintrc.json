{
  "extends": [
    "./tools/node_modules/@interfere/landmines/configs/recommended.json"
  ],
  "jsPlugins": [
    "./tools/oxlint/anti-slop/index.ts"
  ],
  "ignorePatterns": [
    "tools/oxlint/anti-slop/**",
    "expo/build/**",
    "expo/build-scripts/**",
    "expo/plugin/build/**",
    "expo/ios/Vendor/**",
    "expo/example/client/.expo/**",
    "expo/example/client/ios/**",
    "expo/example/client/android/**",
    "exact/Vendor/**"
  ],
  "categories": { "correctness": "error" },
  "rules": {
    // Preserve warning-level reporting for existing findings during cleanup.
    "eslint/no-unused-vars": "warn",
    "eslint/no-unsafe-finally": "warn",
    "eslint/no-control-regex": "warn",
    "unicorn/no-useless-spread": "warn",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "warn",
    "anti-slop/no-conditional-empty-object-spread": "warn",
    "anti-slop/no-known-value-widening": "warn",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "warn",
    "anti-slop/no-reflect-apply": "warn",
    "anti-slop/no-reflect-get": "warn",
    "anti-slop/no-runtime-typeof": "warn",
    "anti-slop/no-unsafe-dictionary-type": "warn",
    "anti-slop/no-shape-in-symbol-names": "warn",
    "anti-slop/no-unknown-parameters": "warn",
    "anti-slop/no-unknown-returns": "warn",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    // Keep guards and their dependent steps together in state transitions and ordered evidence checks.
    "anti-slop/require-readable-spacing": "off",
    "anti-slop/require-safety-comment-for-type-assertion": "warn",
    "landmines-testing/no-fixed-sleep": "warn",
    "landmines-testing/no-flake-masking": "warn",
    "landmines-testing/no-test-doubles": "warn",
    "landmines-testing/no-unsignaled-poll": "error",
    "landmines-testing/strict-msw": "error",
    // Keep evidence-ordering invariants and safety comments for required interop assertions beside the code.
    "landmines-style/no-comments": "off",
    "landmines-structure/colocated-tests": "error",
    "landmines-structure/package-exports": "error",
    "landmines-structure/test-file-names": "warn",
    "landmines-types/no-explicit-return-types": "warn"
  }
}
