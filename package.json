{
  "name": "ios-voip-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "LiveCommunicationKit-first calling for iOS and Expo.",
  "license": "UNLICENSED",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./internal/bootstrap": {
      "types": "./build/internal/bootstrap.d.ts",
      "default": "./build/internal/bootstrap.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "Expo/apple",
    "Sources",
    "profiles",
    "VERSION",
    "IosVoipSDK.podspec",
    "expo-module.config.json"
  ],
  "workspaces": [
    "example"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit --project tsconfig.json && npm run typecheck --workspace ios-voip-sdk-example",
    "format:check": "prettier --check package.json tsconfig.json expo-module.config.json .prettierrc.json 'Expo/**/*.{ts,md}' 'example/*.{ts,tsx,js,json,md}'"
  },
  "peerDependencies": {
    "expo": ">=55.0.0 <56.0.0",
    "react": "19.2.0",
    "react-native": "0.83.x"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "expo": "55.0.32",
    "prettier": "3.9.10",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "typescript": "5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ziahamza/ios-voip-sdk.git"
  }
}
