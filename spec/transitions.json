{
  "version": 0,
  "rules": [
    {"id":"incoming","from":["absent"],"input":"incoming","guard":"newCall","to":"reporting","effects":["reserveIdentity","reportIncoming"]},
    {"id":"admitted","from":["reporting"],"input":"admitted","guard":"noRetainedEnd","to":"ringing","effects":["publish"]},
    {"id":"start","from":["absent"],"input":"start","guard":"newCallAndSlot","to":"placing","effects":["reserveIdentity","requestPlacement"]},
    {"id":"placed-outgoing","from":["placing"],"input":"placed","guard":"outgoingDeferred","to":"dialing","effects":["nativeStart","publish"]},
    {"id":"placed-join","from":["placing"],"input":"placed","guard":"incomingJoin","to":"same","effects":["prepareMedia"]},
    {"id":"answer","from":["ringing"],"input":"answer","guard":"answerEligible","to":"same","effects":["requestClaim"]},
    {"id":"claim-expired","from":["ringing"],"input":"claimExpired","guard":"notReconciled","to":"same","effects":["reconcile"]},
    {"id":"authority-allowed","from":["ringing"],"input":"authorityAllowed","guard":"currentAttempt","to":"same","effects":["prepareMedia"]},
    {"id":"answer-prepared","from":["ringing"],"input":"mediaPrepared","guard":"authorizedAnswerPending","to":"connecting","effects":["settleAction","armConnection","publish"]},
    {"id":"answer-refused","from":["ringing"],"input":"answerRefused","guard":"currentAttempt","to":"ending","effects":["rejectAction","closeMedia","requestRemoval","publish"]},
    {"id":"claim-unresolved","from":["ringing"],"input":"reconciliationUnknown","guard":"currentAttempt","to":"ending","effects":["rejectAction","closeMedia","requestRemoval","publish"]},
    {"id":"connected","from":["dialing","connecting"],"input":"connected","guard":"authoritativeAndPrepared","to":"connected","effects":["setActive","publish"]},
    {"id":"early-connected","from":["dialing","connecting"],"input":"connected","guard":"mediaNotReady","to":"connecting","effects":["bufferProgress","armConnection","publish"]},
    {"id":"deferred-media","from":["dialing","connecting"],"input":"provideMedia","guard":"live","to":"same","effects":["prepareMedia"]},
    {"id":"prepared-after-report","from":["connecting"],"input":"mediaPrepared","guard":"bufferedConnected","to":"connected","effects":["setActive","publish"]},
    {"id":"bind","from":["reporting","ringing","previewing","placing","dialing","connecting","connected","reconnecting"],"input":"bindRemote","guard":"aliasAvailable","to":"same","effects":["bindAlias","drainEvents","publish"]},
    {"id":"no-answer","from":["ringing","dialing"],"input":"noAnswerExpired","guard":"noAnswerPending","to":"ending","effects":["closeMedia","requestRemoval","publish"]},
    {"id":"hold","from":["connected","reconnecting"],"input":"hold","guard":"supported","to":"same","effects":["applyHold","publish"]},
    {"id":"mute","from":["reporting","ringing","previewing","placing","dialing","connecting","connected","reconnecting"],"input":"mute","guard":"supported","to":"same","effects":["applyMute","publish"]},
    {"id":"video","from":["reporting","ringing","previewing","placing","dialing","connecting","connected","reconnecting"],"input":"video","guard":"supported","to":"same","effects":["applyVideo","publish"]},
    {"id":"local-end","from":["reporting","ringing","previewing","placing","dialing","connecting","connected","reconnecting"],"input":"localEnd","guard":"firstTerminalIntent","to":"ending","effects":["closeMedia","requestRemoval","publish"]},
    {"id":"elsewhere-preview","from":["reporting","ringing"],"input":"remoteEnd","guard":"previewPolicy","to":"previewing","effects":["closeMedia","requestRemoval","publish"]},
    {"id":"remote-end","from":["reporting","ringing","previewing","placing","dialing","connecting","connected","reconnecting"],"input":"remoteEnd","guard":"firstTerminalIntent","to":"ending","effects":["closeMedia","requestRemoval","publish"]},
    {"id":"repeat-end","from":["ending","ended"],"input":"localEnd","guard":"always","to":"same","effects":["returnOriginalEnd"]},
    {"id":"removed","from":["ending","ended"],"input":"systemRemoved","guard":"always","to":"same","effects":["publish"]},
    {"id":"late","from":["ended"],"input":"lateCompletion","guard":"always","to":"same","effects":["ignore"]},
    {"id":"join","from":["previewing"],"input":"join","guard":"joinEligible","to":"placing","effects":["requestPlacement"]},
    {"id":"transport-lost","from":["connected"],"input":"transportLost","guard":"live","to":"reconnecting","effects":["armReconnection","publish"]},
    {"id":"transport-recovered","from":["reconnecting"],"input":"transportRecovered","guard":"live","to":"connected","effects":["publish"]},
    {"id":"join-failed","from":["placing","connecting"],"input":"joinFailed","guard":"incomingJoin","to":"previewing","effects":["rejectAction","closeMedia","requestRemoval","restorePreview","publish"]},
    {"id":"join-media-failed","from":["placing","connecting"],"input":"mediaFailed","guard":"incomingJoin","to":"previewing","effects":["rejectAction","closeMedia","requestRemoval","restorePreview","publish"]},
    {"id":"media-failed","from":["placing","ringing","dialing","connecting","connected","reconnecting"],"input":"mediaFailed","guard":"currentAttempt","to":"ending","effects":["rejectAction","closeMedia","requestRemoval","publish"]},
    {"id":"join-deadline","from":["placing","connecting"],"input":"deadlineExpired","guard":"incomingJoin","to":"previewing","effects":["rejectAction","closeMedia","requestRemoval","restorePreview","publish"]},
    {"id":"deadline","from":["placing","ringing","connecting","connected","reconnecting"],"input":"deadlineExpired","guard":"currentAttempt","to":"ending","effects":["rejectAction","closeMedia","requestRemoval","publish"]},
    {"id":"reset","from":["reporting","ringing","placing","dialing","connecting","connected","reconnecting"],"input":"frameworkReset","guard":"live","to":"ending","effects":["rejectAction","closeMedia","requestRemoval","publish"]},
    {"id":"placed-eager","from":["placing"],"input":"placed","guard":"outgoingEager","to":"same","effects":["prepareMedia"]},
    {"id":"eager-prepared","from":["placing"],"input":"mediaPrepared","guard":"outgoingPrepared","to":"dialing","effects":["nativeStart","publish"]},
    {"id":"join-prepared","from":["placing"],"input":"mediaPrepared","guard":"preparedJoin","to":"connecting","effects":["settleAction","armConnection","publish"]},
    {"id":"media-released","from":["ending"],"input":"mediaReleased","guard":"mediaReleased","to":"ended","effects":["publish"]},
    {"id":"late-admission","from":["ending","ended"],"input":"admitted","guard":"always","to":"same","effects":["requestRemoval"]}
  ]
}
