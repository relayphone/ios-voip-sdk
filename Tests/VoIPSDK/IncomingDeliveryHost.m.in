#import "IncomingDeliveryHost.h"
#include <stdbool.h>
#include <stdatomic.h>
#include <time.h>

// Host-only Foundation scaffolding. The runner inserts the current production
// deliverPayload method verbatim and links the actual VSPushDelivery.m.

@interface VSPushDelivery (NativeOwner)
- (instancetype)initWithCompletion:(dispatch_block_t)completion
                         retaining:(id)receiver
                 completionTimeout:(NSTimeInterval)timeout;
- (BOOL)waitForSettlement:(NSTimeInterval)timeout;
@end

@interface PKPushPayload : NSObject
@property(nonatomic, copy) NSDictionary *dictionaryPayload;
@end
@implementation PKPushPayload
@end

@interface HostNativeOwner : NSObject
- (instancetype)initWithReceiver:(id<VSPushReceiver>)receiver;
- (void)deliverPayload:(PKPushPayload *)payload mustReport:(BOOL)mustReport
           completion:(dispatch_block_t)completion;
@end

@implementation HostNativeOwner {
  id<VSPushReceiver> _receiver;
}
- (instancetype)initWithReceiver:(id<VSPushReceiver>)receiver {
  if ((self = [super init])) _receiver = receiver;
  return self;
}

// EXACT_DELIVER_PAYLOAD
@end

static atomic_flag driveUsed = ATOMIC_FLAG_INIT;
static atomic_bool reportEntered;
static atomic_bool callbackReturned;
static atomic_bool reportEnteredAtReturn;
static atomic_bool callbackWasMain;
static atomic_bool mainStallActive;
static atomic_bool returnedDuringMainStall;
static atomic_bool handshakeSucceeded;
static atomic_uint_fast64_t callbackStartNS;
static atomic_uint_fast64_t callbackElapsedNS;
static atomic_uint_fast64_t reportEntryElapsedNS;
static atomic_uint_fast64_t completionElapsedNS;
static atomic_uint_fast64_t completionCount;
static atomic_uint_fast64_t mainStallElapsedNS;

static uint64_t monotonicNS(void) {
  struct timespec value;
  int result = clock_gettime(CLOCK_MONOTONIC, &value);
  NSCAssert(result == 0, @"Host monotonic clock is required.");
  return (uint64_t)value.tv_sec * 1000000000ull + (uint64_t)value.tv_nsec;
}

void HostDrive(id<VSPushReceiver> receiver) {
  NSCAssert(NSThread.isMainThread, @"HostDrive must enter on main.");
  NSCAssert(receiver != nil, @"The actual fixture receiver is required.");
  BOOL alreadyUsed = atomic_flag_test_and_set_explicit(&driveUsed, memory_order_acq_rel);
  NSCAssert(!alreadyUsed,
            @"Run each native wait experiment in a fresh process.");
  HostNativeOwner *owner = [[HostNativeOwner alloc] initWithReceiver:receiver];
  PKPushPayload *payload = [PKPushPayload new];
  payload.dictionaryPayload = @{@"incomingCall": @{@"eventId": @"main-stall-event",
      @"serverCallId": @"main-stall-server", @"caller": @{@"id": @"main-stall-caller"},
      @"hasVideo": @NO}};
  dispatch_queue_t queue = dispatch_queue_create("dev.iosvoipsdk.host.push-main-stall", DISPATCH_QUEUE_SERIAL);
  dispatch_semaphore_t entered = dispatch_semaphore_create(0);
  atomic_store_explicit(&mainStallActive, true, memory_order_release);
  dispatch_async(queue, ^{
    @autoreleasepool {
      atomic_store_explicit(&callbackWasMain, NSThread.isMainThread, memory_order_release);
      uint64_t started = monotonicNS();
      atomic_store_explicit(&callbackStartNS, started, memory_order_release);
      dispatch_semaphore_signal(entered);
      [owner deliverPayload:payload mustReport:YES completion:^{
        atomic_store_explicit(&completionElapsedNS, monotonicNS() - started, memory_order_release);
        atomic_fetch_add_explicit(&completionCount, 1, memory_order_acq_rel);
      }];
      atomic_store_explicit(&reportEnteredAtReturn,
          atomic_load_explicit(&reportEntered, memory_order_acquire), memory_order_release);
      atomic_store_explicit(&callbackElapsedNS, monotonicNS() - started, memory_order_release);
      atomic_store_explicit(&returnedDuringMainStall,
          atomic_load_explicit(&mainStallActive, memory_order_acquire), memory_order_release);
      atomic_store_explicit(&callbackReturned, true, memory_order_release);
    }
  });
  // This is a harness readiness bound, independent of the unchanged native
  // delivery wait/watchdog. Main never yields to an actor task during handshake.
  long status = dispatch_semaphore_wait(entered, dispatch_time(DISPATCH_TIME_NOW, 10 * NSEC_PER_SEC));
  atomic_store_explicit(&handshakeSucceeded, status == 0, memory_order_release);
  NSCAssert(status == 0, @"The host callback worker did not enter.");
  uint64_t stalled = monotonicNS();
  [NSThread sleepForTimeInterval:3.0];
  atomic_store_explicit(&mainStallElapsedNS, monotonicNS() - stalled, memory_order_release);
  atomic_store_explicit(&mainStallActive, false, memory_order_release);
}

void HostReportEntered(void) {
  bool expected = false;
  if (atomic_compare_exchange_strong_explicit(&reportEntered, &expected, true,
      memory_order_acq_rel, memory_order_acquire)) {
    uint64_t started = atomic_load_explicit(&callbackStartNS, memory_order_acquire);
    atomic_store_explicit(&reportEntryElapsedNS, monotonicNS() - started, memory_order_release);
  }
}
uint64_t HostCompletionCount(void) { return atomic_load_explicit(&completionCount, memory_order_acquire); }
BOOL HostCallbackReturned(void) { return atomic_load_explicit(&callbackReturned, memory_order_acquire); }
BOOL HostReportEnteredAtCallbackReturn(void) { return atomic_load_explicit(&reportEnteredAtReturn, memory_order_acquire); }
NSTimeInterval HostCallbackElapsedSeconds(void) { return (double)atomic_load_explicit(&callbackElapsedNS, memory_order_acquire) / 1e9; }
NSTimeInterval HostReportEntryElapsedSeconds(void) { return (double)atomic_load_explicit(&reportEntryElapsedNS, memory_order_acquire) / 1e9; }
BOOL HostCallbackWasMainThread(void) { return atomic_load_explicit(&callbackWasMain, memory_order_acquire); }
BOOL HostReturnedDuringMainStall(void) { return atomic_load_explicit(&returnedDuringMainStall, memory_order_acquire); }
BOOL HostDriveHandshakeSucceeded(void) { return atomic_load_explicit(&handshakeSucceeded, memory_order_acquire); }
NSString *HostMetricsJSON(void) {
  NSDictionary *metrics = @{
    @"reportObservation": @"fixture reporting seam; no LiveCommunicationKit execution",
    @"fixtureReportEnteredAtCallbackReturn": @(HostReportEnteredAtCallbackReturn()),
    @"callbackElapsedSeconds": @(HostCallbackElapsedSeconds()),
    @"reportEntryElapsedSeconds": @(HostReportEntryElapsedSeconds()),
    @"completionElapsedSeconds": @((double)atomic_load_explicit(&completionElapsedNS, memory_order_acquire) / 1e9),
    @"callbackReturned": @(HostCallbackReturned()),
    @"callbackWasMainThread": @(HostCallbackWasMainThread()),
    @"returnedDuringMainStall": @(HostReturnedDuringMainStall()),
    @"driveHandshakeSucceeded": @(HostDriveHandshakeSucceeded()),
    @"completionCount": @(HostCompletionCount()),
    @"mainStallElapsedSeconds": @((double)atomic_load_explicit(&mainStallElapsedNS, memory_order_acquire) / 1e9),
    @"mainStallSeconds": @3.0
  };
  NSData *bytes = [NSJSONSerialization dataWithJSONObject:metrics options:NSJSONWritingSortedKeys error:nil];
  NSCAssert(bytes != nil, @"Host metrics must encode as JSON.");
  return [[NSString alloc] initWithData:bytes encoding:NSUTF8StringEncoding];
}
