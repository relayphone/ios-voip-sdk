#!/usr/bin/env python3
"""Run a command with a deadline and a ten-second owned-group shutdown grace."""
import math
import os
import signal
import subprocess
import sys
import time

GRACE_SECONDS = 10


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        seconds = float(argv[0])
        if not math.isfinite(seconds) or seconds <= 0 or len(argv) < 2:
            raise ValueError()
    except (IndexError, ValueError):
        print('usage: bounded <positive-seconds> <command> [args...]', file=sys.stderr)
        return 2
    pending = []
    def interrupted(signum, _frame):
        if not pending:
            pending.append(signum)
    previous = {sig: signal.signal(sig, interrupted) for sig in (signal.SIGINT, signal.SIGTERM)}
    child = None
    try:
        deadline = time.monotonic() + seconds
        try:
            child = subprocess.Popen(argv[1:], start_new_session=True)
        except OSError as error:
            print('bounded: cannot start command (' + type(error).__name__ + ')', file=sys.stderr)
            return 127 if isinstance(error, FileNotFoundError) else 126
        status = None
        while not pending:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            try:
                if status is None:
                    status = child.wait(timeout=min(remaining, .1))
                if pending:
                    break
                try:
                    os.killpg(child.pid, 0)
                except ProcessLookupError:
                    return status if status >= 0 else 128 - status
                time.sleep(min(remaining, .1))
            except subprocess.TimeoutExpired:
                pass
        def send(sig):
            try:
                os.killpg(child.pid, sig)
            except ProcessLookupError:
                pass
            except OSError as error:
                print('bounded: owned-group signal failed (' + type(error).__name__ + ')', file=sys.stderr)
        send(signal.SIGTERM)
        # Do not reap the leader during grace: its PID pins the owned group ID
        # even if it exits while a descendant ignores SIGTERM.
        time.sleep(GRACE_SECONDS)
        send(signal.SIGKILL)
        try:
            child.wait(timeout=2)
        except (OSError, subprocess.TimeoutExpired) as error:
            print('bounded: owned child cleanup unknown (' + type(error).__name__ + ')', file=sys.stderr)
        return 128 + pending[0] if pending else 124
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)


if __name__ == '__main__':
    sys.exit(main())
