+        func urlSession(_: URLSession, task _: URLSessionTask, didFinishCollecting metrics: URLSessionTaskMetrics) {
+            guard let connectSpan else { return }
+            // Project Foundation's wall-clock dates onto the span's uptime clock.
+            let before = ProcessInfo.processInfo.systemUptime
+            let wallTime = Date()
+            let after = ProcessInfo.processInfo.systemUptime
+            connectSpan.record("ws_metrics_received", at: after)
+            guard let transaction = metrics.transactionMetrics.last else { return }
+            connectSpan.record("ws_metrics_clock_sample_start", at: before)
+            let uptime = (before + after) / 2
+            let dates = [
+                ("ws_dns_start", transaction.domainLookupStartDate),
+                ("ws_dns_end", transaction.domainLookupEndDate),
+                ("ws_tcp_start", transaction.connectStartDate),
+                ("ws_tcp_end", transaction.connectEndDate),
+                ("ws_upgrade_request", transaction.requestStartDate),
+                ("ws_upgrade_response", transaction.responseEndDate),
+            ]
+            for (label, date) in dates {
+                guard let date else { continue }
+                let time = uptime + date.timeIntervalSince(wallTime)
+                if time >= connectSpan.start, time <= after { connectSpan.record(label, at: time) }
+            }
+            if metrics.transactionMetrics.count > 1 { connectSpan.record("ws_multiple_transactions", at: uptime) }
+            if transaction.isProxyConnection {
+                connectSpan.record("ws_proxy", at: uptime)
+            } else if let remoteAddress = transaction.remoteAddress {
+                let isIPv6 = remoteAddress.contains(":") && !remoteAddress.lowercased().hasPrefix("::ffff:")
+                connectSpan.record(isIPv6 ? "ws_ipv6" : "ws_ipv4", at: uptime)
+            }
+        }
