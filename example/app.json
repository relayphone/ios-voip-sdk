{
  "expo": {
    "name": "VoIP SDK Example",
    "slug": "ios-voip-sdk-example",
    "version": "0.0.0",
    "platforms": ["ios"],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.iosvoipsdk.example",
      "supportsTablet": true
    },
    "plugins": [
      [
        "ios-voip-sdk",
        {
          "unhandledAction": "fail",
          "simulatorSupport": true,
          "includesCallsInRecents": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.4"
          }
        }
      ]
    ]
  }
}
